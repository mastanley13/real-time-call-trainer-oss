# Copy to .env (or .env.local) and fill in. Everything is optional for a
# local UI preview: see TESTING.md for the minimum per mode.

# ---- Local demo mode (no database, no login) ----
# Skips login and keeps sessions in the browser. NEVER enable on a public deployment.
# DEMO_MODE=true

# ---- Voice ----
# OpenAI Realtime is the default voice engine whenever an OpenAI key is available:
# OPENAI_REALTIME_API_KEY, else OPENAI_API_KEY, else LLM_API_KEY when LLM_BASE_URL is api.openai.com.
# The server mints a short-lived client secret per call; your key never reaches the browser.
# OPENAI_REALTIME_API_KEY=
# REALTIME_MODEL=gpt-realtime-1.5  # the Premium voice model
# REALTIME_MODEL_STANDARD=gpt-realtime-mini  # used for accounts without Premium, and once Premium reaches 60% of the plan's minutes
# REALTIME_VOICE=marin             # alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
# REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# RATE_LIMIT_REALTIME_MAX=10       # voice calls started per IP per window
# RATE_LIMIT_REALTIME_WINDOW_SEC=3600
#
# ElevenLabs Agents (optional second engine). Create an agent in the ElevenLabs
# dashboard and enable prompt / first-message / voice overrides.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional standard-tier agent. Without it the main agent serves every call and counts as Premium.
# ELEVENLABS_AGENT_ID_STANDARD=
# When both engines are configured, which one the briefing picks first: openai | elevenlabs
# VOICE_ENGINE=openai

# ---- Live coach, grading, persona wizard + text simulation (optional) ----
# Any OpenAI-compatible chat-completions endpoint. Without a key the app falls
# back to a deterministic keyword heuristic and scripted caller replies.
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=            # fallback for LLM_API_KEY only while LLM_BASE_URL is unset or api.openai.com;
#                             # with a custom LLM_BASE_URL it is never sent there, so set LLM_API_KEY

# ---- Database (Postgres) ----
# Required for accounts, teams and server-side session history.
# DATABASE_URL=postgresql://user:password@localhost:5432/call_trainer

# ---- Auth ----
# 32+ random bytes. Generate with: node generate-jwt-secret.js
# Also keys the grade seal (scores are stored only with a valid seal) and the access-code cookie.
JWT_SECRET=

# ---- Cron (retention purge) ----
# /api/cron/purge-expired accepts only "Authorization: Bearer $CRON_SECRET" and returns 401 without it.
# Vercel Cron sends that header itself when CRON_SECRET is set.
CRON_SECRET=

# ---- Billing: Stripe TEST MODE only (optional) ----
# Off when STRIPE_SECRET_KEY is empty and whenever DEMO_MODE=true. A key that does not start with
# sk_test_ is refused on every Stripe call. Create the six prices in the Stripe test dashboard
# (flat licensed prices, no metered usage) and paste only their ids here. Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
# Public origin for Stripe return links (defaults to the request origin)
# APP_BASE_URL=
# Lets the billing webhook emit upgrade, downgrade and churn events to the CRM hook. Off by default.
# GHL_BILLING_EVENTS=true
# RATE_LIMIT_USAGE_MAX=1200          # voice metering routes, per IP
# RATE_LIMIT_USAGE_WINDOW_SEC=600
# RATE_LIMIT_BILLING_MAX=20          # checkout + portal, per IP
# RATE_LIMIT_BILLING_WINDOW_SEC=3600

# ---- Seed (optional, used by `npm run db:seed`) ----
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_FIRST_NAME=
# ADMIN_LAST_NAME=

# ---- Access gate (optional) ----
# When set, the whole app requires this code, except /api/health and /api/cron/* (CRON_SECRET bearer).
# TRAINER_ACCESS_CODE=

# ---- Client IP behind proxies (optional) ----
# How many proxies in front of the app append to X-Forwarded-For. The client IP used for
# rate limits and audit rows is read this many entries from the right. Keep 1 on Vercel or
# behind a single proxy. A CDN in front of Fly, Render or nginx usually needs 2 (see DEPLOY.md).
# The app needs at least one proxy that sets or appends the header; without one, clients pick
# their own address. 0 is not valid and falls back to 1.
# TRUSTED_PROXY_HOPS=1

# ---- Per-IP rate limits (optional; defaults shown) ----
# Per-account limits are fixed in code; TESTING.md lists them all.
# RATE_LIMIT_CALLER_MAX=30
# RATE_LIMIT_CALLER_WINDOW_SEC=300
# RATE_LIMIT_GRADING_MAX=10          # /api/evaluate-call and re-grades, shared
# RATE_LIMIT_GRADING_WINDOW_SEC=3600
# RATE_LIMIT_TOKEN_MAX=10
# RATE_LIMIT_TOKEN_WINDOW_SEC=3600
# RATE_LIMIT_COACH_MAX=120          # live coach, /api/coach/turn
# RATE_LIMIT_COACH_WINDOW_SEC=600
# RATE_LIMIT_WIZARD_MAX=20          # persona wizard + URL import, shared
# RATE_LIMIT_WIZARD_WINDOW_SEC=3600
