# Copy to .env (or .env.local) and fill in. Everything is optional for a
# local UI preview: see TESTING.md for the minimum per mode.

# ---- Local demo mode (no database, no login) ----
# Skips login and keeps sessions in the browser. NEVER enable on a public deployment.
# DEMO_MODE=true

# ---- Voice: ElevenLabs Agents ----
# Create an agent in the ElevenLabs dashboard and enable prompt / first-message / voice overrides.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ---- Post-call grading + text simulation (optional) ----
# Any OpenAI-compatible chat-completions endpoint. Without a key the app falls
# back to a deterministic keyword heuristic and scripted caller replies.
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=            # accepted as a fallback for LLM_API_KEY

# ---- Database (Postgres) ----
# Required for accounts, teams and server-side session history.
DATABASE_URL=postgresql://user:password@localhost:5432/call_trainer

# ---- Auth ----
# 32+ random bytes. Generate with: node generate-jwt-secret.js
JWT_SECRET=

# ---- Cron (retention purge) ----
CRON_SECRET=

# ---- Seed (optional, used by `npm run db:seed`) ----
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ---- Access gate (optional) ----
# When set, the whole app (except /api/health) requires this code.
# TRAINER_ACCESS_CODE=

# ---- Per-IP rate limits (optional; defaults shown) ----
# RATE_LIMIT_CALLER_MAX=30
# RATE_LIMIT_CALLER_WINDOW_SEC=300
# RATE_LIMIT_GRADING_MAX=10
# RATE_LIMIT_GRADING_WINDOW_SEC=3600
# RATE_LIMIT_TOKEN_MAX=10
# RATE_LIMIT_TOKEN_WINDOW_SEC=3600
