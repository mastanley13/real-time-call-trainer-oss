# Copy to .env (or .env.local) and fill in. Everything is optional for a
# local UI preview: see TESTING.md for the minimum per mode.

# ---- Local demo mode (no database, no login) ----
# Skips login and keeps sessions in the browser. NEVER enable on a public deployment.
# DEMO_MODE=true
# With NODE_ENV=production, DEMO_MODE=true is ignored (login stays required) unless you also set
# ALLOW_PUBLIC_DEMO=true. As extra layers the app also refuses to boot, and /api/health falls back
# to 503. Only set it for a deliberate public demo.
# ALLOW_PUBLIC_DEMO=true

# ---- Voice ----
# OpenAI Realtime is the default voice engine whenever an OpenAI key is available:
# OPENAI_REALTIME_API_KEY, else OPENAI_API_KEY, else LLM_API_KEY when LLM_BASE_URL is api.openai.com.
# The server mints a short-lived client secret per call; your key never reaches the browser.
# OPENAI_REALTIME_API_KEY=
# Voice quality (Team page, per organization): Standard by default. Premium only for orgs that are comped AND set
# to Premium; the paid Premium Voice add-on does not change the model. Minute caps and metering are unchanged.
# REALTIME_MODEL_STANDARD=gpt-realtime-2.1-mini  # Standard model; falls back to REALTIME_MODEL, then gpt-realtime-2.1-mini
# REALTIME_MODEL_PREMIUM=gpt-realtime-2.1        # Premium model
# REALTIME_MODEL=                                # legacy: used for Standard when REALTIME_MODEL_STANDARD is unset
# RATE_LIMIT_TEAM_SETTINGS_MAX=30  # voice quality changes per IP per window
# RATE_LIMIT_TEAM_SETTINGS_WINDOW_SEC=3600
# REALTIME_VOICE=marin             # alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
# REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# RATE_LIMIT_REALTIME_MAX=10       # voice calls started per IP per window
# RATE_LIMIT_REALTIME_WINDOW_SEC=3600
#
# ElevenLabs Agents (optional second engine). Create an agent in the ElevenLabs
# dashboard and enable prompt / first-message / voice overrides.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional standard-tier agent. Without it the main agent serves every call and counts as Premium.
# ELEVENLABS_AGENT_ID_STANDARD=
# When both engines are configured, which one the briefing picks first: openai | elevenlabs
# VOICE_ENGINE=openai

# ---- Live coach, grading, persona wizard + text simulation (optional) ----
# Any OpenAI-compatible chat-completions endpoint. Without a key the app falls
# back to a deterministic keyword heuristic and scripted caller replies.
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=            # fallback for LLM_API_KEY only while LLM_BASE_URL is unset or api.openai.com;
#                             # with a custom LLM_BASE_URL it is never sent there, so set LLM_API_KEY

# ---- Database (Postgres) ----
# Required for accounts, teams and server-side session history.
# DATABASE_URL=postgresql://user:password@localhost:5432/call_trainer

# ---- Auth ----
# 32+ random bytes. Generate with: node generate-jwt-secret.js
# Also keys the grade seal (scores are stored only with a valid seal) and the access-code cookie.
JWT_SECRET=

# ---- Cron (retention purge) ----
# /api/cron/purge-expired accepts only "Authorization: Bearer $CRON_SECRET" and returns 401 without it.
# Vercel Cron sends that header itself when CRON_SECRET is set.
CRON_SECRET=

# ---- Voice minute caps (optional) ----
# Off by default: a self-hosted install has no voice minute limit. Set USAGE_CAPS=on (needs DATABASE_URL, not
# DEMO_MODE) to meter voice with no Stripe key: everyone is Free, 10 voice minutes a month, and voice is refused if
# the usage lookup fails. Text practice is never metered. Setting STRIPE_SECRET_KEY also turns the caps on.
# Hosted Production: set USAGE_CAPS=on in Vercel Production before DEMO_MODE comes off, then confirm /api/usage
# reports metered with cap 10.
# USAGE_CAPS=on

# ---- Billing: Stripe (optional; test mode by default) ----
# Off when STRIPE_SECRET_KEY is empty and whenever DEMO_MODE=true. Test keys (sk_test_, rk_test_) work as is.
# Live keys (sk_live_, rk_live_) are refused on every Stripe call unless STRIPE_LIVE_MODE=true (exact string).
# STRIPE_LIVE_MODE=true with a test key is refused too (stripe_mode_mismatch), so a half-flipped env fails loudly.
# The webhook ignores events whose livemode does not match the configured mode. Checkout uses only the price ids below (an allowlist; ids are not
# secrets). Each product needs ct_* metadata: ct_plan=pro or team (ct_addon absent or none; Team may set ct_seat_min,
# default 3), and the Premium add-on ct_plan=addon, ct_addon=premium_voice, ct_version=1. Lookup keys and the older plan/addon keys are never read.
# A blank id means that plan is not offered: checkout answers price_not_configured and nothing is granted.
# Flat licensed prices only, no metered usage. Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to true only with a live key, to allow live mode. Leave unset for test mode.
# STRIPE_LIVE_MODE=true
# Optional Billing Portal configuration id (bpc_...). When set, the portal opens with it instead of the account
# default. Use a configuration limited to this app's products; the account default may allow any price.
# STRIPE_PORTAL_CONFIGURATION=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
# Optional. Days a past-due subscription keeps paid access, from when it first went past due. Whole number,
# 0 to 365; anything else uses 7. Unpaid, paused, incomplete and canceled subscriptions never keep access.
# PAST_DUE_GRACE_DAYS=7
# Public origin for Stripe return links (defaults to the request origin)
# APP_BASE_URL=
# Lets the billing webhook emit upgrade, downgrade and churn events to the CRM hook. Off by default.
# GHL_BILLING_EVENTS=true
# RATE_LIMIT_USAGE_MAX=1200          # voice metering routes, per IP
# RATE_LIMIT_USAGE_WINDOW_SEC=600
# RATE_LIMIT_BILLING_MAX=20          # checkout + portal, per IP
# RATE_LIMIT_BILLING_WINDOW_SEC=3600

# ---- Seed (optional, used by `npm run db:seed`) ----
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_FIRST_NAME=
# ADMIN_LAST_NAME=

# ---- Access gate (optional) ----
# When set, the whole app requires this code, except /api/health and /api/cron/* (CRON_SECRET bearer).
# Public origin for canonical URLs, share images and the sitemap. Never taken from VERCEL_URL. Default: https://calltrainer.tech
# APP_URL=
# TRAINER_ACCESS_CODE=

# ---- Google sign-in (optional) ----
# Needs all three of GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and APP_URL (above), and DATABASE_URL too:
# without a database Google sign-in stays off.
# Authorized redirect URI in Google Cloud: ${APP_URL}/api/auth/google/callback. Unset = no button, routes return 404.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RATE_LIMIT_GOOGLE_MAX=30           # /api/auth/google/start + /callback, per IP
# RATE_LIMIT_GOOGLE_WINDOW_SEC=900

# ---- Client IP behind proxies (optional) ----
# How many proxies in front of the app append to X-Forwarded-For. The client IP used for
# rate limits and audit rows is read this many entries from the right. Keep 1 on Vercel or
# behind a single proxy. A CDN in front of Fly, Render or nginx usually needs 2 (see DEPLOY.md).
# The app needs at least one proxy that sets or appends the header; without one, clients pick
# their own address. 0 is not valid and falls back to 1.
# TRUSTED_PROXY_HOPS=1

# ---- Per-IP rate limits (optional; defaults shown) ----
# Per-account limits are fixed in code; TESTING.md lists them all.
# RATE_LIMIT_CALLER_MAX=30
# RATE_LIMIT_CALLER_WINDOW_SEC=300
# RATE_LIMIT_GRADING_MAX=10          # /api/evaluate-call and re-grades, shared
# RATE_LIMIT_GRADING_WINDOW_SEC=3600
# RATE_LIMIT_TOKEN_MAX=10
# RATE_LIMIT_TOKEN_WINDOW_SEC=3600
# RATE_LIMIT_COACH_MAX=120          # live coach, /api/coach/turn
# RATE_LIMIT_COACH_WINDOW_SEC=600
# RATE_LIMIT_WIZARD_MAX=20          # persona wizard + URL import, shared
# RATE_LIMIT_WIZARD_WINDOW_SEC=3600
