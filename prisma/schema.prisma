// Real-Time Call Trainer — core data model
//
// Design notes:
// - Multi-tenant by Organization. Every user and every training record
//   belongs to an org. The only exception is a platform-wide admin flag
//   on the User row for the application owner ("owner of application").
// - Org code is a stable 3-digit string (may expand later; stored as text).
// - All user data lives in this DB; there is no third-party CRM dependency.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // For Neon (pooled): when running `prisma migrate deploy`, set
  // DATABASE_URL to the DIRECT (non-pooled) URL. The pooled URL is
  // still used at runtime by the app.
}

// ─────────────────────────────────────────────────────────────────────────
//  Organizations & users
// ─────────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  /// 3-digit join code issued at signup, displayed to managers / shared with
  /// their team. Unique across the platform.
  code      String   @unique
  name      String
  /// Subscription tier; "free" until billing/webhook sets otherwise.
  planTier  String   @default("free")
  /// Paid seats on the Team plan; the voice pool is seatCount x 300 minutes. 1 while on Free.
  seatCount Int      @default(1)
  /// Premium Voice add-on (quantity = seats). Premium voice is capped at 60% of plan minutes.
  premiumVoice Boolean @default(false)
  /// Stripe ids (test mode only for now). Set by the webhook, never by the client.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus   String?
  /// The one outstanding Checkout Session for this billing subject, so a second click reuses it instead of
  /// opening another. Cleared when the subscription lands or the session expires.
  stripeCheckoutSessionId   String?
  stripeCheckoutFingerprint String?
  stripeCheckoutUrl         String?
  stripeCheckoutExpiresAt   DateTime?
  /// Nullable = keep training records indefinitely. When set, the nightly
  /// purge job deletes TrainerSession rows older than this many days.
  sessionRetentionDays Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  trainerSessions     TrainerSession[]
  trainingAssignments TrainingAssignment[]
  poolAllowance       UsageAllowance? @relation("OrgPool")
}

enum UserRole {
  trainee   // default
  manager   // can see their org's trainees + reports
  owner     // an org admin (can manage users in the org)
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  firstName        String?
  lastName         String?
  phone            String?
  role             UserRole @default(trainee)
  /// Platform-level admin flag for the APPLICATION owner. Independent of
  /// the user's role inside their own org.
  isPlatformAdmin  Boolean  @default(false)
  /// Optional for platform admins who don't need an org.
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  lastLoginAt      DateTime?
  failedLoginCount Int      @default(0)
  lockedUntil      DateTime?
  /// TOTP MFA state. `mfaSecret` holds the base32 secret while enrollment
  /// is pending; once the user proves possession it stays put and
  /// `mfaEnabled` flips true.
  mfaSecret        String?
  mfaEnabled       Boolean  @default(false)
  mfaEnrolledAt    DateTime?
  /// Individual plan: free | pro. Team members draw from their organization's pool instead.
  planTier         String   @default("free")
  premiumVoice     Boolean  @default(false)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus   String?
  /// See Organization: the one outstanding Checkout Session for this subject.
  stripeCheckoutSessionId   String?
  stripeCheckoutFingerprint String?
  stripeCheckoutUrl         String?
  stripeCheckoutExpiresAt   DateTime?
  /// Set when a call ran past its reservation; no voice call is minted for this user until then.
  voiceBlockedUntil         DateTime?
  /// Monthly usage reset anchor for all plans. Defaults to signup time and never moves.
  usageAnchorAt    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  usageAllowance      UsageAllowance?
  usageEntries        UsageEntry[]
  trainerSessions     TrainerSession[]
  auditEvents         AuditEvent[]
  assignmentsCreated  TrainingAssignment[] @relation("AssignmentAssigner")
  assignmentsReceived TrainingAssignment[] @relation("AssignmentAssignee")

  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────
//  Training sessions
// ─────────────────────────────────────────────────────────────────────────

model TrainerSession {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Client-generated id for the practice session (voice or text). The column
  /// name predates the ElevenLabs migration and is kept to avoid a data migration.
  realtimeSessionId  String?
  scenarioId         String
  scenarioCategory   String?
  scenarioDifficulty String?
  scenarioTitle      String?
  /// Client-reported length, for display only. Billing uses the server timestamps below.
  durationSeconds    Int      @default(0)
  /// Voice metering, all set by the server. A null connectedAt means the call never connected.
  connectedAt        DateTime?
  endedAt            DateTime?
  endReason          CallEndReason?
  lastHeartbeatAt    DateTime?
  /// First moment a heartbeat reported the connection as recovering; cleared when it recovers.
  degradedAt         DateTime?
  billableSeconds    Int      @default(0)
  billedMinutes      Int      @default(0)
  /// The allowance and period this call was started against. Settlement charges these, not whatever
  /// allowance the user resolves to later (a Team join or a month rollover mid-call).
  allowanceId        String?
  allowancePeriodStart DateTime?
  /// Minutes held for this call at mint time. Also the server-side maximum length of the call.
  reservedMinutes    Int      @default(0)
  /// Voice engine the session was minted for: "premium" or "standard".
  engineTier         String   @default("standard")
  /// Of reservedMinutes, how many were also held against the Premium limit. Minutes beyond this book as standard.
  premiumReservedMinutes Int  @default(0)
  /// What this open call holds in the NEXT period when the period rolled over mid-call (set by the rollover).
  carriedMinutes     Int      @default(0)
  carriedPremiumMinutes Int   @default(0)
  /// Set when the server saw the call run past its reservation (see usage.ts, flagOverrun).
  abuseFlagged       Boolean  @default(false)
  usageEntries       UsageEntry[]
  /// Raw transcript turns.
  transcript         Json
  /// Full structured evaluation object (or null if eval failed).
  evaluation         Json?
  /// Denormalized overall score + grade for fast listing / filtering.
  overallScore       Int?
  grade              String?
  goalAchieved       Boolean?
  /// Free-form supervisor feedback visible on the debrief page. Nullable
  /// until a manager/owner adds notes.
  supervisorNotes     String?
  supervisorNotesBy   String?
  supervisorNotesAt   DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([scenarioId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
//  Voice minute metering
// ─────────────────────────────────────────────────────────────────────────

/// One row per billing subject: a user (Free, Pro) or an organization pool (Team).
model UsageAllowance {
  id             String   @id @default(cuid())
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?  @unique
  organization   Organization? @relation("OrgPool", fields: [organizationId], references: [id], onDelete: Cascade)
  /// free | pro | team
  planTier       String
  /// 20, 200, or seats x 300.
  minutesCap     Int
  /// Copied from User.usageAnchorAt (or the organization's createdAt for a Team pool).
  anchorAt       DateTime
  periodStart    DateTime
  periodEnd      DateTime
  /// Cached net sum of this period's ledger entries, updated in the same transaction as each entry.
  minutesUsed    Int      @default(0)
  /// Minutes held by calls that have started and not settled. A new call can only take what is left after
  /// used and reserved, which is what stops two calls from spending the same minutes.
  minutesReserved Int     @default(0)
  /// Net minutes this period that ran on the premium voice engine (the 60% Premium limit counts these).
  premiumMinutesUsed Int  @default(0)
  /// Premium minutes held by open calls. Premium is only chosen for a call while used + reserved is under the limit.
  premiumMinutesReserved Int @default(0)
  /// Compare-and-swap counter: a reservation only lands if nobody changed the row since it was read.
  version        Int      @default(0)
  updatedAt      DateTime @updatedAt
}

/// Append-only ledger. Usage is positive, credits are negative. A session has at most one entry
/// per kind, which is what makes repeated end events idempotent.
model UsageEntry {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allowanceId      String
  trainerSessionId String?
  trainerSession   TrainerSession? @relation(fields: [trainerSessionId], references: [id], onDelete: SetNull)
  kind             UsageKind
  minutes          Int
  createdAt        DateTime @default(now())

  @@unique([trainerSessionId, kind])
  @@index([allowanceId, createdAt])
  @@index([userId])
}

enum UsageKind {
  voice_call
  /// The part of a call that ran in a period that has since ended (net of any drop credit).
  voice_call_prior
  credit_drop
  credit_manual
}

enum CallEndReason {
  user_hangup
  network_drop
  provider_error
  server_error
  cap_reached
  max_duration
  heartbeat_timeout
  failed_connect
}

// ─────────────────────────────────────────────────────────────────────────
//  Billing
// ─────────────────────────────────────────────────────────────────────────

/// Stripe event ids already handled by the webhook, so a redelivery is acknowledged and ignored.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
//  Training assignments
// ─────────────────────────────────────────────────────────────────────────

/// A persona a manager asks one rep (or the whole team) to practise.
/// Completion is derived, never stored: a TrainerSession by the assignee with
/// the same scenarioId created after the assignment counts as done.
model TrainingAssignment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedById   String
  assignedBy     User         @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: Cascade)
  /// Null means the whole team.
  assigneeId     String?
  assignee       User?        @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  scenarioId     String
  /// Denormalized so the list still reads well if the persona is renamed or removed.
  scenarioTitle  String
  note           String?
  dueAt          DateTime?
  createdAt      DateTime     @default(now())
  /// Archived assignments drop off every list; the row is kept for history.
  archivedAt     DateTime?

  @@index([organizationId, archivedAt])
  @@index([assigneeId])
  @@index([assignedById])
}

// ─────────────────────────────────────────────────────────────────────────
//  Audit log
// ─────────────────────────────────────────────────────────────────────────

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
